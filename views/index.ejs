<%- include('partials/header') %>

<h1>Upcoming Raids</h1>

<% if (events.length === 0) { %>
  <div class="empty-state">
    <p>No raids scheduled yet. Check back soon!</p>
  </div>
<% } else { %>
  <div class="event-grid">
    <% events.forEach((event) => { %>
      <a href="/events/<%= event.id %>" class="event-card">
        <div class="event-card__header">
          <h2><%= event.name %></h2>
        </div>
        <div class="event-card__body">
          <% if (event.description) { %>
            <p class="event-card__desc"><%= event.description %></p>
          <% } %>
          <div class="event-card__meta">
            <span class="event-card__date">📅 <time class="local-datetime" datetime="<%= event.datetime %>"><%= event.datetime %></time></span>
          </div>
          <div class="event-card__roster-count">
            👥 <%= event.roster.length %> enrolled
          </div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
